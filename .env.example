# Copia este archivo como .env y completa los valores.

# --- MySQL ---
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=gestion_activos_db

# --- Frontend (CORS) ---
CORS_ORIGINS=http://localhost,http://localhost:4200,http://localhost:5173

# --- Keycloak ---
KEYCLOAK_URL=http://host.docker.internal:8080
KEYCLOAK_REALM=gestion-activos
KEYCLOAK_ISSUER=http://localhost:8080/realms/gestion-activos
KEYCLOAK_AUDIENCE=gestion-activos-api
KEYCLOAK_ADMIN=
KEYCLOAK_PASSWORD=

# --- GLPI local de pruebas (servicios glpi y glpi-db; solo con: docker compose --profile glpi up) ---
# Base de datos EXCLUSIVA de GLPI: no comparte nada con la base principal.
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
# (Opcional) Por defecto glpi_local / glpi_root_local: la base no publica ningún puerto.
# GLPI_DB_PASSWORD=
# GLPI_DB_ROOT_PASSWORD=

# --- Worker de sincronización (servicio glpi-sync, mismo perfil) ---
# GLPI local: http://glpi/api.php · GLPI de la empresa: https://.../api.php
GLPI_API_URL=http://glpi/api.php
# Cliente OAuth de GLPI (Configuración > Clientes OAuth; grant "Password", scope "api").
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
# Cuenta de servicio de SOLO LECTURA en GLPI.
GLPI_USERNAME=
GLPI_PASSWORD=
# ⚠️ SOLO DESARROLLO: true = no validar el certificado HTTPS de GLPI. Riesgo: las
# credenciales pueden ser interceptadas. Nunca en producción.
# GLPI_IGNORE_SSL=true
# Zona horaria del SERVIDOR GLPI (sus fechas llegan en hora local, sin desfase).
GLPI_TIMEZONE=America/Guayaquil
# true = simulación (no escribe). Cambia a false solo tras revisar el informe.
GLPI_DRY_RUN=true
GLPI_SYNC_CRON=0 2 * * *
