# Copia este archivo como .env y completa los valores.

# --- MySQL ---
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=gestion_activos_db

# --- Frontend (CORS) ---
CORS_ORIGINS=http://localhost,http://localhost:4200,http://localhost:5173

# --- Keycloak ---
KEYCLOAK_URL=http://host.docker.internal:8080
KEYCLOAK_REALM=gestion-activos
KEYCLOAK_ISSUER=http://localhost:8080/realms/gestion-activos
KEYCLOAK_AUDIENCE=gestion-activos-api
KEYCLOAK_ADMIN=
KEYCLOAK_PASSWORD=

# --- GLPI local de pruebas (servicios glpi y glpi-db; solo con: docker compose --profile glpi up) ---
# Base de datos EXCLUSIVA de GLPI: no comparte nada con la base principal.
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
# (Opcional) Por defecto glpi_local / glpi_root_local: la base no publica ningún puerto.
# GLPI_DB_PASSWORD=
# GLPI_DB_ROOT_PASSWORD=

# --- Worker de sincronización (servicio glpi-sync, mismo perfil) ---
# La conexión con GLPI (GLPI_API_URL, credenciales, GLPI_TIMEZONE, GLPI_ITEMTYPES…) NO va
# aquí: se define en gestion-activos-api/.env, que comparten el worker, la API y la consola.
# Aquí solo se decide cómo trabaja el worker:
# true = simulación (no escribe). Cambia a false solo con un respaldo verificado y tras
# revisar una simulación (docs/glpi-sync.md, "Activar la escritura automática").
GLPI_DRY_RUN=true
# Cada cuánto corre el trabajador. Cada ejecución es incremental (ligera).
GLPI_SYNC_CRON=*/15 * * * *
# Cada cuántas horas hace la lectura completa que detecta equipos eliminados en GLPI.
GLPI_RECONCILIACION_HORAS=24
# Minutos de margen hacia atrás en cada consulta incremental.
GLPI_VENTANA_SEGURIDAD_MIN=15
