# Copia este archivo como .env (valores de desarrollo; no son secretos).

# Realm de Keycloak (URL pública, la abre el navegador).
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/gestion-activos
# Cliente público con PKCE definido en keycloak/realm-gestion-activos.json.
VITE_OIDC_CLIENT_ID=gestion-activos-web
