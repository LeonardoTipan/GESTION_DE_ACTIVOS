# Copia este archivo como .env y completa los valores.
DATABASE_URL="mysql://USUARIO:CONTRASENA@localhost:3306/gestion_activos_db"

# Orígenes del frontend autorizados a llamar a la API (CORS), separados por comas.
CORS_ORIGINS="http://localhost,http://localhost:4200,http://localhost:5173"

# --- Keycloak ---
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="gestion-activos"
KEYCLOAK_ISSUER="http://localhost:8080/realms/gestion-activos"
KEYCLOAK_AUDIENCE="gestion-activos-api"

# Administrador de Keycloak: solo para keycloak/configurar-keycloak.ps1. La API NO lo usa.
KEYCLOAK_ADMIN=""
KEYCLOAK_PASSWORD=""

# Contraseña de los usuarios de prueba (la que pasaste a configurar-keycloak.ps1).
KEYCLOAK_TEST_PASSWORD=""
