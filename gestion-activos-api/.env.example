# Copia este archivo como .env y completa los valores.
DATABASE_URL="mysql://USUARIO:CONTRASENA@localhost:3306/gestion_activos_db"
# Base AISLADA para los tests e2e (se vacía en cada ejecución). Debe terminar en "_test".
DATABASE_URL_TEST="mysql://USUARIO:CONTRASENA@localhost:3306/gestion_activos_test"

# Orígenes del frontend autorizados a llamar a la API (CORS), separados por comas.
CORS_ORIGINS="http://localhost,http://localhost:4200,http://localhost:5173"

# (Opcional) URL pública de la API vista desde el navegador. Por defecto http://localhost:3000.
# API_PUBLIC_URL="http://localhost:3000"

# --- Keycloak ---
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="gestion-activos"
KEYCLOAK_ISSUER="http://localhost:8080/realms/gestion-activos"
KEYCLOAK_AUDIENCE="gestion-activos-api"

# Administrador de Keycloak: solo para keycloak/configurar-keycloak.ps1. La API NO lo usa.
KEYCLOAK_ADMIN=""
KEYCLOAK_PASSWORD=""

# Contraseña de los usuarios de prueba (la que pasaste a configurar-keycloak.ps1).
KEYCLOAK_TEST_PASSWORD=""

# --- Sincronización con GLPI (proceso aparte: npm run glpi:simular / glpi:sync / glpi:worker) ---
# Base de la API v2 de GLPI (termina en /api.php). Fuera de la red local debe ser https://
GLPI_API_URL="https://glpi.tu-empresa.com/api.php"
# Cliente OAuth de GLPI (Configuración > Clientes OAuth), con el grant "Password" y el scope "api".
GLPI_CLIENT_ID=""
GLPI_CLIENT_SECRET=""
# Usuario de GLPI con el que se pide el token. Usa una cuenta de servicio de SOLO LECTURA,
# no tu usuario personal. El token se pide solo en cada sincronización: no se guarda aquí.
GLPI_USERNAME=""
GLPI_PASSWORD=""
# ⚠️ SOLO DESARROLLO. "true" = NO validar el certificado HTTPS de GLPI (p. ej. si está
# caducado). Sin validación, las credenciales de arriba pueden ser interceptadas: es un
# riesgo real. Nunca en producción (el motor lo rechaza con NODE_ENV=production).
# Quítala en cuanto se renueve el certificado.
# GLPI_IGNORE_SSL="true"
# OBLIGATORIA: zona horaria del SERVIDOR GLPI (sus fechas llegan en hora local, sin desfase).
GLPI_TIMEZONE="America/Guayaquil"

# true (por defecto) = SIMULACIÓN: lee, compara e informa sin escribir. Solo "false" escribe.
GLPI_DRY_RUN="true"
# Tipos a sincronizar (admitidos: Computer, NetworkEquipment, Software).
GLPI_ITEMTYPES="Computer,NetworkEquipment,Software"
# Elementos por petición a GLPI.
GLPI_TAMANO_BLOQUE="10"
# (Opcional) Tope por tipo, para pruebas. Vacío = todos.
# GLPI_MAX_POR_TIPO="10"
# Cuándo se ejecuta el worker (expresión cron). Por defecto, cada 15 minutos: cada
# ejecución es incremental y solo pide a GLPI lo modificado desde la anterior.
GLPI_SYNC_CRON="*/15 * * * *"
# (Opcional) auto (por defecto) | completa | incremental. "auto" = incremental y, cada
# GLPI_RECONCILIACION_HORAS, una lectura completa que detecta equipos eliminados en GLPI.
# GLPI_SYNC_MODO="auto"
# GLPI_RECONCILIACION_HORAS="24"
# (Opcional) Minutos que se retrocede desde el punto de control en cada consulta
# incremental: absorbe diferencias de reloj con GLPI. Releer de más es inocuo.
# GLPI_VENTANA_SEGURIDAD_MIN="15"
# (Opcional) Minutos tras los que el bloqueo de una ejecución caída se da por abandonado.
# GLPI_BLOQUEO_CADUCA_MIN="30"
# Criticidad (nivel del catálogo) para los activos creados desde GLPI.
GLPI_CRITICIDAD_DEFECTO="Media"
# Código institucional: texto que lo precede en el comentario de GLPI ("QUITO TURISMO: 7-1-22-177").
# Vacío = no se busca. Si es válido y único se usa como código operativo del activo.
GLPI_CODIGO_INSTITUCIONAL_ETIQUETA="QUITO TURISMO"
# (Opcional) Formato que debe cumplir para usarse como código (expresión regular).
# Por defecto: cuatro grupos numéricos separados por guiones.
# GLPI_CODIGO_INSTITUCIONAL_FORMATO="^\d+(-\d+){3}$"
# (Opcional) "true" = los activos que sigan con el código de respaldo (GLPI-PC-12) pasan a su
# código institucional o n.º de inventario cuando es válido y único. No toca códigos puestos a mano.
# GLPI_MEJORAR_CODIGOS="false"
# (Opcional) Categoría local de cada tipo. Por defecto: Hardware, Red y Software.
# GLPI_CATEGORIA_COMPUTER="Hardware"
# GLPI_CATEGORIA_NETWORKEQUIPMENT="Red"
# GLPI_CATEGORIA_SOFTWARE="Software"
# (Opcional) Versión de la API en la ruta y scope del token.
# GLPI_API_VERSION="v2"
# GLPI_SCOPE="api"
# (Opcional) Carpeta de los informes JSON de auditoría.
# GLPI_DIR_INFORMES="glpi-informes"
