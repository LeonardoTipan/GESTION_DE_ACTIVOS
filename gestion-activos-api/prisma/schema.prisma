// Modelo de datos de Gestión de Activos.
// Traducido del diagrama ER (Mermaid) validado por el ingeniero líder: Modulado.txt

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Catálogos
// ---------------------------------------------------------------------------

model Categoria {
  id                   Int                 @id @default(autoincrement())
  nombre               String              @unique
  descripcion          String
  // Control de acceso: si los activos de la categoría admiten solicitudes de
  // acceso lógico (contienen o dan acceso a información) o físico. Lo decide el
  // admin en Catálogos; la sincronización con GLPI no lo toca.
  admiteAccesoLogico   Boolean             @default(false)
  admiteAccesoFisico   Boolean             @default(false)
  // Mantenimiento: si sus activos son HARDWARE (preventivo, correctivo, predictivo) o
  // SOFTWARE (preventivo, correctivo, perfectivo, adaptativo, evolutivo). null = sin
  // clasificar (solo preventivo y correctivo). La decide el admin en Catálogos.
  claseMantenimiento   ClaseMantenimiento?
  // Elegibilidad de sus activos en cada módulo (la decide el admin en Catálogos; la
  // sincronización con GLPI no la toca). No sustituye el estado operativo del activo:
  // un activo debe estar operativo Y su categoría habilitada. Solo se exige al crear
  // registros nuevos; los existentes se conservan aunque la categoría deje de aplicar.
  aplicaMantenimiento  Boolean             @default(false)
  aplicaVulnerabilidad Boolean             @default(false)
  aplicaRenovacion     Boolean             @default(false)
  // Preparadas para módulos futuros (Evaluación de Sistemas Productivos y Protección de
  // Endpoints): aún no habilitan selectores ni operaciones.
  aplicaEvaluacion     Boolean             @default(false)
  aplicaEndpoint       Boolean             @default(false)

  activos Activo[] // CATEGORIA ||--o{ ACTIVO : "agrupa"

  @@map("categoria")
}

model Criticidad {
  id    Int    @id @default(autoincrement())
  nivel String @unique

  activos Activo[] // CRITICIDAD ||--o{ ACTIVO : "clasifica"

  @@map("criticidad")
}

// ---------------------------------------------------------------------------
// Inventario
// ---------------------------------------------------------------------------

model Activo {
  id                  Int       @id @default(autoincrement())
  // Código OPERATIVO de la aplicación: único y editable. No es la identidad
  // del activo sincronizado (esa es origenGlpi) ni el n.º de inventario de GLPI.
  codigo              String    @unique
  // Elemento de GLPI del que procede ("Computer #12"); null si se registró a mano.
  // Es la identidad con la que la sincronización reconoce el activo.
  origenGlpi          String?   @unique
  // N.º de inventario tal como está en GLPI (otherserial). Puede repetirse.
  numeroInventario    String?
  // Código institucional ORIGINAL, tal como se anotó (sin corregir). Puede repetirse.
  codigoInstitucional String?
  nombre              String
  sistemas            String
  custodio            String
  ubicacion           String
  cifrado             Boolean
  ultimaRevision      DateTime
  // Datos técnicos (los informa GLPI; también se pueden registrar a mano)
  numeroSerie         String?
  estado              String?
  fabricante          String?
  // Tipo de equipo (Laptop, Switch…) y modelo comercial
  tipo                String?
  modelo              String?
  // Técnico a cargo del soporte, red a la que se conecta y contacto de uso
  tecnicoResponsable  String?
  red                 String?
  contacto            String?
  // Cuándo se registró en el inventario de origen (GLPI)
  fechaAlta           DateTime?
  // Datos LOCALES: GLPI no los informa y la sincronización nunca los toca
  direccionIp         String?
  fechaCompra         DateTime?
  // Características técnicas: texto largo, conserva los saltos de línea
  comentario          String?   @db.Text
  categoriaId         Int
  criticidadId        Int

  // Sincronización con el frontend: permite pedir "lo que cambió desde X".
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Baja manual desde la aplicación: el activo pasa a "No activo" y conserva su historial.
  deletedAt      DateTime?
  // "No activo" detectado por la sincronización: desde cuándo y por qué
  // (PAPELERA_GLPI | AUSENTE_EN_GLPI). null = sigue vigente en GLPI.
  inactivoDesde  DateTime?
  motivoInactivo String?

  categoria  Categoria  @relation(fields: [categoriaId], references: [id])
  criticidad Criticidad @relation(fields: [criticidadId], references: [id])

  bitacora            BitacoraHistorial[] // "registra cambios en"
  respaldos           Respaldo[] // "tiene capas de" (registros anteriores al plan de respaldo)
  planesRespaldo      PlanRespaldo[]
  ejecucionesRespaldo EjecucionRespaldo[]
  restauraciones      Restauracion[]
  planesMantenimiento PlanMantenimiento[]
  mantenimientos      Mantenimiento[] // "sigue ciclo de"
  vulnerabilidades    Vulnerabilidad[] // "presenta ciclo de"
  notificaciones      Notificacion[]
  controlesAcceso     ControlAcceso[]
  renovaciones        Renovacion[] // licencias, garantías, certificados y contratos del activo
  evaluaciones        EvaluacionSistema[] // pasos a producción evaluados (Evaluación de Sistemas Productivos)

  @@index([updatedAt])
  // Filtro "activos / no activos" del inventario
  @@index([deletedAt, inactivoDesde])
  @@index([numeroInventario])
  @@index([codigoInstitucional])
  @@map("activo")
}

// ---------------------------------------------------------------------------
// Tablas dependientes de ACTIVO
// ---------------------------------------------------------------------------

model BitacoraHistorial {
  id          Int      @id @default(autoincrement())
  activoId    Int
  accion      String
  responsable String
  fecha       DateTime
  // JSON con los campos modificados: {"campo": {"antes": ..., "despues": ...}}
  detalle     String   @db.Text

  activo Activo @relation(fields: [activoId], references: [id])

  @@map("bitacora_historial")
}

model Respaldo {
  id              Int             @id @default(autoincrement())
  activoId        Int
  // Capa 1: alcance (se define al crear el respaldo)
  alcanceDetalle  String
  // Capa 2: ejecución (se completa al ejecutar el respaldo)
  estadoEjecucion EstadoEjecucion @default(PENDIENTE)
  fechaEjecucion  DateTime?
  rutaEvidencia   String? // URL o ruta de red donde está la evidencia
  // Capa 3: restauración / pruebas (solo tras una ejecución EXITOSA)
  estadoPrueba    EstadoPrueba    @default(PENDIENTE)
  resultadoPrueba String?
  fechaPrueba     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  activo Activo @relation(fields: [activoId], references: [id])

  @@index([updatedAt])
  @@map("respaldo")
}

enum EstadoEjecucion {
  PENDIENTE
  EXITOSA
  FALLIDA
}

enum EstadoPrueba {
  PENDIENTE
  APROBADA
  FALLIDA
}

// Capa 2 · Ejecución: cada intervención (programada desde un plan o directa).
model Mantenimiento {
  id                     Int               @id @default(autoincrement())
  activoId               Int
  // Plan del que procede (capa 1); null si se programó directamente
  planId                 Int?
  tipo                   TipoMantenimiento
  // Ciclo: PROGRAMADO → EN_EJECUCION → FINALIZADO (o CANCELADO)
  fase                   FaseMantenimiento @default(PROGRAMADO)
  // Cómo quedó el equipo: se registra al FINALIZAR
  estadoEquipo           EstadoEquipo?
  actividad              String
  // Resultado al finalizar, o motivo al cancelar
  resultado              String?
  // Fecha programada
  fecha                  DateTime
  fechaInicio            DateTime?
  fechaFin               DateTime?
  // Datos de la ejecución (se exigen al finalizar)
  tecnico                String?
  diagnostico            String?           @db.Text
  duracionMin            Int?
  costo                  Decimal?          @db.Decimal(12, 2)
  repuestos              String?           @db.Text
  observaciones          String?           @db.Text
  // Referencia a la evidencia (acta, informe, ruta de red)
  // «Verificable»: nombre del informe o documento que prueba la ejecución.
  evidencia              String?
  // «Repositorio verificable»: dónde está guardado (carpeta compartida o URL http/https).
  repositorioVerificable String?
  // Cuándo se canceló (momento del registro). La fecha real de fin (fechaFin) no se usa
  // para las cancelaciones: el trabajo no terminó.
  fechaCancelacion       DateTime?
  // Versión del registro: sube con cada modificación (el detalle, en registro_cambio)
  // Plazo previsto de la ejecución: [fecha, fechaLimite]. fechaLimiteOriginal: antes de una ampliación.
  fechaLimite            DateTime?
  fechaLimiteOriginal    DateTime?
  // Registrado fuera del intervalo previsto: solo un admin, con justificación.
  fueraDePlazo           Boolean           @default(false)
  motivoExcepcion        String?           @db.Text
  excepcionPor           String?
  // HISTÓRICO de la antigua fase de verificación (retirada): ventana prevista. Se conserva por
  // los datos registrados antes del cambio a dos fases; el código ya no la escribe.
  verificacionPrevista   DateTime?
  verificacionLimite     DateTime?

  version         Int       @default(1)
  // Eliminación LÓGICA: el registro se conserva, se excluye de los indicadores
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activo         Activo                      @relation(fields: [activoId], references: [id])
  plan           PlanMantenimiento?          @relation(fields: [planId], references: [id])
  // HISTÓRICO: verificaciones de la antigua fase 3 (solo lectura en la base; sin rutas).
  verificaciones VerificacionMantenimiento[]

  @@index([updatedAt])
  @@index([planId])
  @@map("mantenimiento")
}

// Capa 1 · Planificación: qué mantenimiento necesita un activo y cada cuánto.
model PlanMantenimiento {
  id           Int                     @id @default(autoincrement())
  activoId     Int
  tipo         TipoMantenimiento
  frecuencia   FrecuenciaMantenimiento
  // PLANIFICACIÓN: fecha de inicio planificada. Fija (no avanza al programar): de ella
  // se derivan el semestre (S1 ene–jun, S2 jul–dic) y el año planificados.
  fechaInicio  DateTime
  // Próxima intervención prevista; null cuando ya no hay más (frecuencia única ya programada)
  proximaFecha DateTime?
  responsable  String
  // Actividades previstas en cada intervención
  actividades  String                  @db.Text
  estado       EstadoPlan              @default(VIGENTE)
  // Días que tiene cada intervención para completarse desde su inicio previsto.
  plazoDias    Int                     @default(7)

  version         Int       @default(1)
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activo         Activo          @relation(fields: [activoId], references: [id])
  mantenimientos Mantenimiento[]

  @@index([activoId, estado])
  @@map("plan_mantenimiento")
}

enum FrecuenciaMantenimiento {
  UNICA
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

// HISTÓRICO · Verificaciones de la antigua fase 3 del mantenimiento (retirada: el mantenimiento
// tiene solo dos fases y completar la ejecución lo cierra). La tabla se conserva porque guarda
// verificaciones reales registradas antes del cambio; no hay código que la lea ni la escriba.
model VerificacionMantenimiento {
  id              Int                                @id @default(autoincrement())
  mantenimientoId Int
  fecha           DateTime
  resultado       ResultadoVerificacionMantenimiento
  observaciones   String                             @db.Text
  evidencia       String?
  responsable     String
  // Usuario que la registró (del token)
  registradoPor   String
  // Registrado fuera del intervalo previsto: solo un admin, con justificación.
  fueraDePlazo    Boolean                            @default(false)
  motivoExcepcion String?                            @db.Text
  excepcionPor    String?

  version         Int       @default(1)
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mantenimiento Mantenimiento @relation(fields: [mantenimientoId], references: [id])

  @@index([mantenimientoId])
  @@map("verificacion_mantenimiento")
}

enum ResultadoVerificacionMantenimiento {
  OPERATIVO
  REQUIERE_SEGUIMIENTO
  NO_SATISFACTORIO
}

/// Tipos de mantenimiento. Comunes: PREVENTIVO y CORRECTIVO. Solo hardware: PREDICTIVO.
/// Solo software: PERFECTIVO, ADAPTATIVO y EVOLUTIVO (ver ClaseMantenimiento).
enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
  PREDICTIVO
  PERFECTIVO
  ADAPTATIVO
  EVOLUTIVO
}

/// Clase de un activo a efectos de mantenimiento (por su categoría).
enum ClaseMantenimiento {
  HARDWARE
  SOFTWARE
}

enum FaseMantenimiento {
  PROGRAMADO
  EN_EJECUCION
  FINALIZADO
  CANCELADO
}

enum EstadoEquipo {
  OPERATIVO
  DEGRADADO
  FUERA_DE_SERVICIO
}

model Vulnerabilidad {
  // Dos fases sobre el MISMO registro: Detección y Remediación (no hay fase de verificación).
  id                     Int                  @id @default(autoincrement())
  // «Sistema»: el activo real de GLPI (clave foránea, sin copiar su nombre)
  activoId               Int
  // Identificador público opcional, p. ej. CVE-2026-12345
  cve                    String?
  // «Vulnerabilidad»: descripción del problema detectado
  descripcion            String               @db.Text
  // «Criticidad»: CRITICO, ALTO, MEDIO o BAJO
  nivelRiesgo            NivelRiesgo
  // «Estado»: ABIERTO → EN_PROGRESO → REMEDIADO (reabrir: REMEDIADO → EN_PROGRESO)
  estado                 EstadoVulnerabilidad @default(ABIERTO)
  // «Observación»: acciones, detalles técnicos, limitaciones (no sustituye la descripción)
  observacion            String?              @db.Text
  // «Fecha Detección»: la indica el usuario (puede ser histórica); ≠ createdAt
  fecha                  DateTime
  // Plazo opcional para remediarla (SLA)
  fechaLimite            DateTime?
  // «Fecha de Remediación»: fecha REAL de la solución, indicada por el usuario. Sin valor
  // por defecto: nunca la pone el servidor. Vacía mientras no está remediada.
  fechaRemediacion       DateTime?
  // Origen del registro (MANUAL: la aplicación no tiene escáner conectado)
  fuente                 FuenteVulnerabilidad @default(MANUAL)
  // «Verificable»: nombre del informe o documento que prueba la remediación
  evidencia              String?
  // «Repositorio Verificable»: carpeta compartida o URL http(s) donde está la evidencia
  repositorioVerificable String?
  // «Responsable»: persona encargada (texto: las identidades viven en Keycloak)
  responsable            String?
  // Quién registró la remediación (usuario de la sesión)
  cerradaPor             String?
  // Inicio real del trabajo (opcional, lo indica el usuario al pasar a EN_PROGRESO)
  tratamientoIniciadoEn  DateTime?

  // Versión del registro: sube con cada modificación (el detalle, en registro_cambio)
  version         Int       @default(1)
  // Eliminación LÓGICA: el registro se conserva, se excluye de los indicadores
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?   @db.Text
  // Fecha de registro (automática)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activo Activo @relation(fields: [activoId], references: [id])

  @@index([updatedAt])
  @@index([activoId, estado])
  @@map("vulnerabilidad")
}

enum FuenteVulnerabilidad {
  MANUAL
  ESCANEO
  AUDITORIA
  BOLETIN_PROVEEDOR
  PRUEBA_PENETRACION
  REPORTE_USUARIO
}

// Orden de menor a mayor: MySQL ordena los ENUM por posición, así que
// "orderBy nivelRiesgo desc" pone CRITICO primero.
enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EstadoVulnerabilidad {
  ABIERTO
  EN_PROGRESO
  REMEDIADO
}

// ---------------------------------------------------------------------------
// Sincronización con GLPI
// ---------------------------------------------------------------------------

// Una fila por ejecución REAL (las simulaciones no escriben nada).
model Sincronizacion {
  id            Int                  @id @default(autoincrement())
  origen        OrigenSincronizacion
  modo          ModoSincronizacion
  estado        EstadoSincronizacion @default(EN_CURSO)
  // Usuario que pulsó el botón; null en las ejecuciones automáticas.
  solicitadaPor String?
  // Tipos de GLPI que cubrió ("Computer,NetworkEquipment")
  tipos         String
  inicio        DateTime
  fin           DateTime?
  // PUNTO DE CONTROL: instante hasta el que GLPI quedó procesado. Solo se
  // rellena si la ejecución terminó sin errores; la siguiente incremental
  // parte de aquí (menos la ventana de seguridad).
  puntoControl  DateTime?
  leidos        Int                  @default(0)
  creados       Int                  @default(0)
  actualizados  Int                  @default(0)
  sinCambios    Int                  @default(0)
  inactivados   Int                  @default(0)
  reactivados   Int                  @default(0)
  omitidos      Int                  @default(0)
  errores       Int                  @default(0)
  porRevisar    Int                  @default(0)
  // Cambios que GLPI traía frente a los que realmente se escribieron
  detectados    Int                  @default(0)
  aplicados     Int                  @default(0)
  // JSON: errores generales y cambios por elemento
  resumen       String?              @db.Text
  // BLOQUEO: true mientras se ejecuta, null al terminar. Al ser única, la base
  // impide dos ejecuciones a la vez (MySQL admite varios null).
  enCurso       Boolean?             @unique

  notificaciones Notificacion[]

  @@index([estado, fin])
  @@map("sincronizacion")
}

enum OrigenSincronizacion {
  MANUAL
  AUTOMATICA
  CONSOLA
}

enum ModoSincronizacion {
  COMPLETA
  INCREMENTAL
}

enum EstadoSincronizacion {
  EN_CURSO
  EXITOSA
  CON_ERRORES
  FALLIDA
}

// Avisos visibles en la aplicación sobre lo que cambió al sincronizar.
model Notificacion {
  id               Int              @id @default(autoincrement())
  tipo             TipoNotificacion
  titulo           String
  // JSON con los cambios { campo: { antes, despues } } o { mensaje }
  detalle          String           @db.Text
  fecha            DateTime         @default(now())
  leida            Boolean          @default(false)
  activoId         Int?
  sincronizacionId Int?

  activo         Activo?         @relation(fields: [activoId], references: [id])
  sincronizacion Sincronizacion? @relation(fields: [sincronizacionId], references: [id])

  @@index([leida, fecha])
  @@index([activoId])
  @@map("notificacion")
}

enum TipoNotificacion {
  ALTA
  MODIFICACION
  CAMBIO_ESTADO
  BAJA_DETECTADA
  REACTIVACION
  ERROR_SINCRONIZACION
  // Eventos de los módulos operativos
  RESPALDO_FALLIDO
  MANTENIMIENTO_NO_SATISFACTORIO
  VULNERABILIDAD_CRITICA
  VULNERABILIDAD_REABIERTA
}

// ---------------------------------------------------------------------------
// Respaldos y restauración (A.8.13, A.5.30): plan → ejecución → restauración
// ---------------------------------------------------------------------------

// Paso 1 · Alcance: qué activo se respalda y con qué parámetros comprometidos.
model PlanRespaldo {
  id               Int                @id @default(autoincrement())
  activoId         Int
  frecuencia       FrecuenciaRespaldo
  tipo             TipoRespaldo
  medio            MedioRespaldo
  ventana          VentanaRespaldo
  retencion        RetencionRespaldo
  frecuenciaPrueba FrecuenciaPrueba
  // Pérdida de datos tolerable (horas) y tiempo objetivo de recuperación (minutos)
  rpoHoras         Int
  rtoMinutos       Int
  responsable      String
  estado           EstadoPlan         @default(VIGENTE)
  // Desde cuándo rige: a partir de aquí se cuentan sus ventanas programadas
  vigenteDesde     DateTime
  justificacion    String             @db.Text
  // Versión del registro: sube con cada modificación (el detalle, en registro_cambio)
  version          Int                @default(1)
  // Eliminación LÓGICA: el registro se conserva, se excluye de los indicadores
  anuladoEn        DateTime?
  anuladoPor       String?
  motivoAnulacion  String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  activo      Activo              @relation(fields: [activoId], references: [id])
  ejecuciones EjecucionRespaldo[]

  @@index([activoId, estado])
  @@map("plan_respaldo")
}

// Paso 2 · Cada corrida del respaldo sobre un activo con plan.
model EjecucionRespaldo {
  id              Int                @id @default(autoincrement())
  planId          Int
  // El activo del plan (se copia para consultar y conservar el vínculo)
  activoId        Int
  fecha           DateTime
  tipo            TipoRespaldo
  medio           MedioRespaldo
  volumenGb       Int
  duracionMin     Int
  rpoHoras        Int
  resultado       ResultadoOperacion
  responsable     String
  // Controles de seguridad del respaldo
  cifrado         Boolean
  fueraSitio      Boolean
  inmutable       Boolean
  integridad      Boolean
  // Referencia a lo generado (ruta, etiqueta de cinta, id del trabajo): se documenta, no se verifica
  evidencia       String?
  observaciones   String?            @db.Text
  // Versión del registro: sube con cada modificación (el detalle, en registro_cambio)
  // Registrado fuera del intervalo previsto: solo un admin, con justificación.
  fueraDePlazo    Boolean            @default(false)
  motivoExcepcion String?            @db.Text
  excepcionPor    String?
  // Capa 3: ventana prevista para la prueba de restauración de esta copia.
  pruebaPrevista  DateTime?
  pruebaLimite    DateTime?

  version         Int       @default(1)
  // Eliminación LÓGICA: el registro se conserva, se excluye de los indicadores
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  plan           PlanRespaldo   @relation(fields: [planId], references: [id])
  activo         Activo         @relation(fields: [activoId], references: [id])
  restauraciones Restauracion[]

  @@index([activoId, fecha])
  @@index([fecha])
  @@map("ejecucion_respaldo")
}

// Paso 3 · Restauración o prueba de un respaldo ejecutado (mide el RTO).
model Restauracion {
  id              Int                @id @default(autoincrement())
  ejecucionId     Int
  activoId        Int
  fecha           DateTime
  motivo          MotivoRestauracion
  resultado       ResultadoOperacion
  tiempoRealMin   Int
  rtoMinutos      Int
  integridad      Boolean
  // Acta o ticket que respalda la restauración
  evidencia       String
  responsable     String
  observaciones   String?            @db.Text
  // Versión del registro: sube con cada modificación (el detalle, en registro_cambio)
  // Registrado fuera del intervalo previsto: solo un admin, con justificación.
  fueraDePlazo    Boolean            @default(false)
  motivoExcepcion String?            @db.Text
  excepcionPor    String?

  version         Int       @default(1)
  // Eliminación LÓGICA: el registro se conserva, se excluye de los indicadores
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ejecucion EjecucionRespaldo @relation(fields: [ejecucionId], references: [id])
  activo    Activo            @relation(fields: [activoId], references: [id])

  @@index([activoId, fecha])
  @@index([fecha])
  @@map("restauracion")
}

enum FrecuenciaRespaldo {
  DIARIO
  SEMANAL
  QUINCENAL
  MENSUAL
  TRIMESTRAL
}

enum FrecuenciaPrueba {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum TipoRespaldo {
  COMPLETO
  INCREMENTAL
  DIFERENCIAL
  SNAPSHOT
}

enum MedioRespaldo {
  DISCO_A_DISCO
  CINTA_LTO8
  NUBE_INMUTABLE
  NAS_SECUNDARIO
}

enum VentanaRespaldo {
  NOCTURNA_22_02
  NOCTURNA_00_04
  FIN_DE_SEMANA
  HORARIO_LABORAL
  CONTINUA
}

enum RetencionRespaldo {
  DIAS_30
  DIAS_90
  MESES_6
  ANIO_1
  ANIOS_3
  ANIOS_7
}

enum EstadoPlan {
  VIGENTE
  SUSPENDIDO
}

enum ResultadoOperacion {
  EXITOSO
  PARCIAL
  FALLIDO
}

enum MotivoRestauracion {
  PRUEBA_PROGRAMADA
  INCIDENTE_DISPONIBILIDAD
  SOLICITUD_PROPIETARIO
  VERIFICACION_INTEGRIDAD
}

// ---------------------------------------------------------------------------
// Trazas: versiones anteriores de los registros de respaldos, mantenimientos
// y vulnerabilidades (modificación con motivo, anulación y reversión)
// ---------------------------------------------------------------------------

model RegistroCambio {
  id          Int      @id @default(autoincrement())
  // PLAN_RESPALDO | EJECUCION_RESPALDO | RESTAURACION | MANTENIMIENTO | VULNERABILIDAD
  entidad     String
  registroId  Int
  // Versión del registro ANTES del cambio
  version     Int
  // MODIFICAR | ANULAR | REVERSAR
  accion      String
  motivo      String   @db.Text
  // JSON: [{ campo, antes, despues }]
  cambios     String   @db.Text
  responsable String
  fecha       DateTime @default(now())

  @@index([entidad, registroId])
  @@map("registro_cambio")
}

// ---------------------------------------------------------------------------
// Control de acceso: solicitudes de acceso lógico y físico (una sola tabla)
// ---------------------------------------------------------------------------

model ControlAcceso {
  id                        Int                 @id @default(autoincrement())
  // CAL-001 (lógico) o CAF-001 (físico): lo genera el backend con un contador por tipo.
  codigoUnico               String              @unique @db.VarChar(20)
  tipoAcceso                TipoAcceso
  // Activo inventariado al que se refiere; si no lo hay, `recurso` describe el
  // recurso no inventariado (correo institucional, sala de servidores…).
  activoId                  Int?
  recurso                   String?             @db.VarChar(191)
  fechaSolicitud            DateTime
  // Quién solicita o autoriza el trámite. Obligatorio en las solicitudes nuevas; null en
  // las registradas antes de existir estos campos (no se inventan).
  nombreSolicitante         String?             @db.VarChar(191)
  cargoSolicitante          String?             @db.VarChar(191)
  // Quién recibe (ALTA) o pierde (BAJA) el acceso: una persona distinta del solicitante.
  nombreUsuarioBeneficiario String              @db.VarChar(191)
  departamento              String              @db.VarChar(191)
  tipoSolicitud             TipoSolicitudAcceso
  descripcion               String              @db.Text
  // Flujo administrativo de la solicitud: NO es el estado del activo (no lo toca).
  estado                    EstadoControlAcceso @default(ABIERTO)
  // Qué se hizo al atenderla (acceso otorgado o retirado): obligatorio al cerrar.
  resolucion                String?             @db.Text
  fechaCreacion             DateTime            @default(now())
  // Fecha y hora REALES en que se atendió: la indica quien cierra (puede ser histórica,
  // anterior al registro). Obligatoria al cerrar; null mientras no esté cerrada.
  fechaAtendido             DateTime?
  updatedAt                 DateTime            @updatedAt

  activo    Activo?                  @relation(fields: [activoId], references: [id], onDelete: Restrict)
  historial HistorialControlAcceso[]

  @@index([tipoAcceso, estado])
  @@index([fechaSolicitud])
  @@index([activoId])
  @@map("control_acceso")
}

/// Auditoría de cada solicitud: un registro por campo modificado. Solo se escribe
/// desde el backend, en la misma transacción que el cambio; no hay rutas para editarla.
model HistorialControlAcceso {
  id              Int      @id @default(autoincrement())
  controlAccesoId Int
  // Campo modificado, o CREACION al registrar la solicitud.
  campo           String   @db.VarChar(64)
  valorAnterior   String?  @db.Text
  valorNuevo      String?  @db.Text
  // Usuario autenticado (del token), nunca enviado por el cliente.
  usuario         String
  fecha           DateTime @default(now())
  // Motivo del cambio (obligatorio al reabrir y al corregir una solicitud cerrada).
  motivo          String?  @db.Text

  controlAcceso ControlAcceso @relation(fields: [controlAccesoId], references: [id])

  @@index([controlAccesoId, fecha])
  @@map("historial_control_acceso")
}

/// Último correlativo emitido por tipo de acceso. Se incrementa con UPDATE dentro
/// de la transacción que crea la solicitud: el bloqueo de fila de InnoDB serializa
/// las peticiones simultáneas, sin count() + 1 ni contadores en memoria.
model ContadorControlAcceso {
  tipoAcceso TipoAcceso @id
  ultimo     Int        @default(0)

  @@map("contador_control_acceso")
}

enum TipoAcceso {
  LOGICO
  FISICO
}

enum TipoSolicitudAcceso {
  ACCESO
  BAJA
}

enum EstadoControlAcceso {
  ABIERTO
  PENDIENTE
  CERRADO
}

// ── Renovaciones ─────────────────────────────────────────────────────────────
// Dos fases sobre el MISMO registro: Planificación y Ejecución y cierre (no hay
// fase de verificación: la evidencia se exige al cerrar). Las fechas son DÍAS.

enum TipoRenovacion {
  LICENCIA
  GARANTIA
  CERTIFICADO
  // Nube, hosting, soporte o suscripción con un proveedor
  CONTRATO_SERVICIO
  OTRO
}

// Estado del PROCESO (distinto de la vigencia del elemento, que se calcula)
enum EstadoRenovacion {
  ABIERTO
  EN_PROGRESO
  CERRADO
}

model Renovacion {
  id                     Int              @id @default(autoincrement())
  // «Sistema»: el activo real de GLPI (clave foránea; la renovación no lo modifica)
  activoId               Int
  tipo                   TipoRenovacion
  // «Responsable»: persona encargada (texto: las identidades viven en Keycloak)
  responsable            String
  // «Fecha Planificada»: día previsto para renovar
  fechaPlanificada       DateTime         @db.Date
  // Vigencia ANTES de renovar. Se conserva como referencia histórica: nunca se
  // sobrescribe con la nueva. Vacía solo si sinCaducidadActual (con justificación).
  fechaCaducidadActual   DateTime?        @db.Date
  sinCaducidadActual     Boolean          @default(false)
  estado                 EstadoRenovacion @default(ABIERTO)
  // «Fecha Ejecutada Renovación»: fecha REAL, la indica el usuario (nunca el servidor)
  fechaRenovacion        DateTime?        @db.Date
  // Vigencia DESPUÉS de renovar. Vacía solo si nuevaSinCaducidad (con justificación).
  nuevaFechaCaducidad    DateTime?        @db.Date
  nuevaSinCaducidad      Boolean          @default(false)
  // «Verificable»: contrato, factura, certificado renovado, informe…
  evidencia              String?
  // «Repositorio Verificable»: carpeta compartida o URL http(s)
  repositorioVerificable String?
  // «Descripción»: detalle de la renovación realizada
  descripcion            String?          @db.Text
  // «Observación»: información adicional; justifica la ausencia de caducidad
  observacion            String?          @db.Text
  // Quién registró el cierre (usuario de la sesión)
  cerradaPor             String?
  // Renovación anterior del MISMO elemento (activo y tipo): la cadena conserva
  // la historia; la anterior queda «sustituida» por esta.
  renovacionAnteriorId   Int?

  // Versión del registro: sube con cada modificación (el detalle, en registro_cambio)
  version         Int       @default(1)
  // Eliminación LÓGICA: el registro se conserva
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?   @db.Text
  // Fecha de registro (automática)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activo     Activo       @relation(fields: [activoId], references: [id])
  anterior   Renovacion?  @relation("CadenaRenovaciones", fields: [renovacionAnteriorId], references: [id])
  siguientes Renovacion[] @relation("CadenaRenovaciones")

  @@index([activoId, tipo])
  @@index([estado])
  @@index([fechaCaducidadActual])
  @@index([nuevaFechaCaducidad])
  @@index([updatedAt])
  @@map("renovacion")
}

// ── Protección de Endpoints ──────────────────────────────────────────────────
// Métrica MENSUAL de cobertura de antivirus/EDR (docs/requisitos-proteccion-endpoints.md).
// Fase 1 (implementada): apertura del período. Fase 2 (pendiente): total de activos,
// equipos con antivirus y el Excel del inventario como evidencia; sus campos se añadirán
// con su propia migración. Un solo período por año y mes.

enum EstadoPeriodoEndpoint {
  ABIERTO
  EN_PROGRESO
  CERRADO
}

model PeriodoEndpoint {
  id          Int                   @id @default(autoincrement())
  anio        Int
  // 1 = enero … 12 = diciembre
  mes         Int
  // Persona encargada del período (texto: las identidades viven en Keycloak)
  responsable String
  observacion String?               @db.Text
  estado      EstadoPeriodoEndpoint @default(ABIERTO)

  version         Int       @default(1)
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?   @db.Text
  // Fecha de apertura (automática); no es una fecha de negocio
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([anio, mes])
  @@index([estado])
  @@map("periodo_endpoint")
}

// ── Evaluación de Sistemas Productivos ────────────────────────────────────────
// Evaluación de seguridad de un sistema antes de su paso a producción
// (docs/requisitos-evaluacion-sistemas.md). Fase 1 (implementada): planificación con la
// fecha PROGRAMADA de paso a producción, que no es la fecha de solicitud. Fase 2
// (pendiente): fecha real de las pruebas de seguridad e informe verificable.

enum EstadoEvaluacionSistema {
  ABIERTO
  EN_PROGRESO
  CERRADO
}

model EvaluacionSistema {
  id                        Int                     @id @default(autoincrement())
  // Sistema evaluado: activo operativo de una categoría con aplicaEvaluacion
  activoId                  Int
  // Fecha y hora previstas para el paso a producción (puede ser futura)
  fechaProgramadaProduccion DateTime
  // «Asignado»: quién realiza la evaluación
  responsable               String
  // «Descripción planificada»: qué cambio o versión pasa a producción y qué se evaluará
  descripcion               String                  @db.Text
  estado                    EstadoEvaluacionSistema @default(ABIERTO)

  version         Int       @default(1)
  anuladoEn       DateTime?
  anuladoPor      String?
  motivoAnulacion String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activo Activo @relation(fields: [activoId], references: [id], onDelete: Restrict)

  @@index([activoId, estado])
  @@index([fechaProgramadaProduccion])
  @@map("evaluacion_sistema")
}
